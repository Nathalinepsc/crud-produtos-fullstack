@model ProjetoNsaSenhora.Web.Models.ProdutoCreateViewModel

@{
    ViewData["Title"] = "Cadastrar Produto";
}

<h2>Cadastrar Produto</h2>

<form asp-action="Create" method="post">

    <div class="form-group">
        <label>Nome</label>
        <input asp-for="Nome" class="form-control" />
    </div>

    <div class="form-group">
        <label>Descrição</label>
        <textarea asp-for="Descricao" class="form-control"></textarea>
    </div>

    <div class="form-group">
        <label>Quantidade em Estoque</label>
        <input asp-for="QuantidadeEstoque" class="form-control" type="number" />
    </div>

    <div class="form-group">
        <label>Preço Unitário</label>
        <input asp-for="PrecoUnitario" class="form-control" type="number" step="0.01" />
    </div>

    <div class="form-group">
        <label>Percentual Desconto</label>
        <input asp-for="PercentualDesconto" class="form-control" type="number" step="0.01" />
    </div>

    <div class="form-group">
        <label>Status Categoria</label>
        <select asp-for="StatusCategoria" class="form-control">
            <option value="0">Eletrônicos</option>
            <option value="1">Vestuário</option>
            <option value="2">Alimentos</option>
            <option value="3">Livros</option>
            <option value="4">Brinquedos</option>
            <option value="5">Esportes</option>
            <option value="6">Casa</option>
            <option value="7">Beleza</option>
            <option value="8">Automotivo</option>
            <option value="9">Outros</option>
        </select>
    </div>

    <br />

    <button type="submit" class="btn btn-success">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>

</form>